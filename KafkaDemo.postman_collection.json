  "item": [
    {
      "name": "Registration",
      "item": [
        {
          "name": "Register - success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set('username', `pmuser${suffix}`);",
                  "pm.collectionVariables.set('email', `pmuser${suffix}@example.test`);",
                  "pm.collectionVariables.set('password', `Pm-Test-${suffix}-Password!`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response contains safe user fields and the default User role', function () {",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.username).to.eql(pm.collectionVariables.get('username'));",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(body.roles).to.include('User');",
                  "});",
                  "pm.test('Response does not expose credentials or internal auth state', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).not.to.include(pm.collectionVariables.get('password').toLowerCase());",
                  "    ['passwordhash', 'failedlogincount', 'lockoutuntilutc'].forEach(function (field) {",
                  "        pm.expect(text).not.to.include(field);",
                  "    });",
                  "});",
                  "pm.collectionVariables.set('userId', String(body.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"fullName\": \"{{fullName}}\",\n  \"password\": \"{{password}}\",\n  \"age\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a unique test user. Re-running this request creates a different username, email, and password."
          },
          "response": []
        },
