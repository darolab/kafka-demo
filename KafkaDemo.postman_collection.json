        {
          "name": "Login - incorrect password (same generic response)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Incorrect password returns generic 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Unknown-user and wrong-password response bodies match', function () {",
                  "    pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('genericLoginFailure'));",
                  "});"
                ]
              }
            }
