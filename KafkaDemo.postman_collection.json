    {
      "name": "JWT handshake smoke tests",
      "item": [
        {
          "name": "WebSocket handshake - missing JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing JWT is rejected with 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/WebSocket/connect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "WebSocket",
                "connect"
              ]
            },
            "description": "Sends a normal HTTP request without upgrading to WebSocket; authentication should reject it before handshake processing."
          },
          "response": []
        },
        {
          "name": "WebSocket handshake - malformed JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed JWT is rejected with 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/WebSocket/connect?access_token=not.a.valid.jwt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "WebSocket",
                "connect"
              ],
              "query": [
                {
                  "key": "access_token",
                  "value": "not.a.valid.jwt"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "WebSocket handshake - valid login JWT reaches upgrade check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid JWT is accepted by authentication and HTTP request reaches WebSocket upgrade check', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/WebSocket/connect?access_token={{accessToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "WebSocket",
                "connect"
              ],
              "query": [
                {
                  "key": "access_token",
                  "value": "{{accessToken}}"
                }
              ]
            },
            "description": "A normal HTTP request with the login token is expected to return 400 because it is not a WebSocket upgrade. This verifies the token passed authentication. Use a WebSocket client for a real upgrade test."
          },
          "response": []
        }
      ]
    }
  ]
